# CropMedic backend security configuration
# Development defaults are safe for localhost. Set these explicitly in production.

CROPMEDIC_ENV=production

# Comma-separated HTTPS origins allowed to call the API from browsers.
# Example: https://app.cropmedic.co.zw,https://www.cropmedic.co.zw
CROPMEDIC_CORS_ORIGINS=https://app.example.com

# Comma-separated hostnames accepted by the backend.
# Example: api.cropmedic.co.zw
CROPMEDIC_TRUSTED_HOSTS=api.example.com

# Keep true in production when TLS terminates at the app/proxy in a compatible setup.
CROPMEDIC_FORCE_HTTPS=true

# Only enable when deployed behind a trusted reverse proxy that controls X-Forwarded-For.
CROPMEDIC_TRUST_PROXY=false

# Upload protection.
CROPMEDIC_MAX_IMAGE_BYTES=8388608
CROPMEDIC_MAX_IMAGE_PIXELS=20000000

# Basic per-client prediction rate limit.
CROPMEDIC_RATE_LIMIT_REQUESTS=30
CROPMEDIC_RATE_LIMIT_WINDOW_SECONDS=60
