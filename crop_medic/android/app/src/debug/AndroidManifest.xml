<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Internet access is required for local development and the Flutter tool. -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!--
      Local CropMedic testing may use an http:// LAN backend.
      This override applies to debug builds only. Release builds keep Android's
      normal cleartext restrictions and should point to the production HTTPS API.
    -->
    <application android:usesCleartextTraffic="true"/>
</manifest>
